{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen3.6-35b",
  "plugin": [
    "opencode-ollama-toolcall-proxy"
  ],
  "instructions": [
    ".project-ai/notes.md"
  ],
  "provider": {
    "linux": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Linux",
      "options": {
        "baseURL": "http://178.156.133.161:9008/v1"
      },
      "models": {
        "qwen3:14b-20k": {
          "name": "Qwen3 14B 20K (Linux)",
          "limit": {
            "context": 20480,
            "output": 4096
          }
        },
        "qwen3:14b-16k": {
          "name": "Qwen3 14B 16K (Linux)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    },
    "mac": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Mac",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b-64k": {
          "name": "Qwen3 Coder 30B 64K (Mac)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp Linux",
      "options": {
        "baseURL": "http://192.168.0.50:9008/v1"
      },
      "models": {
        "qwen3-coder-30b": {
          "name": "Qwen3 Coder 30B MoE (Linux)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.6-35b": {
          "name": "Qwen3.6 35B MoE (Linux)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "lsp": true,
  "mcp": {
    "serena": {
      "command": "uvx",
      "args": [
        "serena",
        "--project-root",
        "/Users/kenny/PropertyProjects/DBProjects"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "git diff*": "allow",
      "git status*": "allow",
      "*": "ask"
    }
  }
}
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
  ],
  "instructions": [
    ".project-ai/notes.md"
  ],
  "lsp": true,
  "mcp": {
    "serena": {
      "command": "uvx",
      "args": [
        "serena",
        "--project-root",
        "/Users/kenny/PropertyProjects/DBProjects"
